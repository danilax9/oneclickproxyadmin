# Пароль для входа в веб-панель. ОБЯЗАТЕЛЬНО смените перед деплоем на прод!
ADMIN_PASSWORD=change_me_to_a_strong_password

# Порт, на котором будет доступна сама веб-панель (не прокси-порты)
PANEL_PORT=8000

# Секретный ключ для подписи сессионных cookie.
# Если оставить пустым — будет сгенерирован и сохранён в volume автоматически.
# Рекомендуется сгенерировать один раз: openssl rand -hex 32
SECRET_KEY=

# Email для Let's Encrypt
ACME_EMAIL=admin@example.com

# DNS-режим SSL (если 443 занят Xray) — Cloudflare API Token
# CF_API_TOKEN=your_cloudflare_api_token
# CF_ACCOUNT_ID=optional_cloudflare_account_id
